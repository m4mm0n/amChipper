<Project>
  <PropertyGroup>
    <Version>0.2.5.2</Version>
    <AssemblyVersion>0.2.5.2</AssemblyVersion>
    <FileVersion>0.2.5.2</FileVersion>
    <InformationalVersion>v0.2.5.2-AMC20260601.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <LibOpenMptNetRoot Condition="'$(LibOpenMptNetRoot)' == ''">$(MSBuildThisFileDirectory)..\..\libopenmpt.net</LibOpenMptNetRoot>
    <UseManagedLibOpenMpt Condition="'$(UseManagedLibOpenMpt)' == '' and Exists('$(LibOpenMptNetRoot)\libopenmpt.net.Core\libopenmpt.net.Core.csproj')">true</UseManagedLibOpenMpt>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'QuickLog'">
    <Version>2.4.0</Version>
    <AssemblyVersion>2.4.0.0</AssemblyVersion>
    <FileVersion>2.4.0.0</FileVersion>
    <InformationalVersion>v2.4.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
